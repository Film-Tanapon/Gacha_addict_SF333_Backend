# Server
PORT=3000
NODE_ENV=development

# Postgres (used by docker-compose)
POSTGRES_USER=gacha
POSTGRES_PASSWORD=gacha_password
POSTGRES_DB=gacha_addict

# Prisma connection string
# When running via docker-compose, host = "db" (the service name)
# When running locally against docker's postgres, host = "localhost"
DATABASE_URL="postgresql://gacha:gacha_password@db:5432/gacha_addict?schema=public"

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Firebase Admin SDK (for Google login)
# Paste the full contents of your Firebase service account JSON here as one line,
# OR set the 3 individual fields below instead.
FIREBASE_SERVICE_ACCOUNT_JSON=

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Admin dashboard /admin (generate a long random secret)
ADMIN_API_KEY=

# Public privacy contact (not credentials)
PRIVACY_OPERATOR_NAME=Aymahakon
PRIVACY_SUPPORT_EMAIL=filmoko2345@gmail.com

# Managed daily database/image backups; automatic expiry starts at day 89
# with hourly sweeps to stay within the published 90-day maximum.
BACKUP_ENABLED=false
BACKUP_DIR=./private-backups
# Keep this ledger separate and NEVER overwrite it when restoring a backup.
DELETION_LEDGER_PATH=./private-data/account-deletions.jsonl
# Optional local PostgreSQL executable paths; Docker includes these tools.
PG_DUMP_PATH=
PG_RESTORE_PATH=

# Gmail SMTP (server only; never put the App Password in the mobile app)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Generate with: openssl rand -hex 32 (server only; do not rotate during a reset).
PASSWORD_RESET_SECRET=
# Set only to the number of trusted reverse proxies in front of this API.
TRUST_PROXY_HOPS=0

# Optional password-protected inbox for ONE dedicated Play review test account.
# Copies only app-generated reset/confirmation emails, in memory for 10 minutes.
# Use a real test-account email, never SMTP_USER or a real user's address.
# Inbox password is separate from the app password: openssl rand -hex 24
# HTTPS URL after enabling: https://YOUR_API_HOST/review-inbox
REVIEW_INBOX_ENABLED=false
REVIEW_INBOX_EMAIL=
REVIEW_INBOX_PASSWORD=
