# Server
PORT=3000
NODE_ENV=development

# Postgres (used by docker-compose)
POSTGRES_USER=gacha
POSTGRES_PASSWORD=gacha_password
POSTGRES_DB=gacha_addict

# Prisma connection string
# When running via docker-compose, host = "db" (the service name)
# When running locally against docker's postgres, host = "localhost"
DATABASE_URL="postgresql://gacha:gacha_password@db:5432/gacha_addict?schema=public"

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Firebase Admin SDK (for Google login)
# Paste the full contents of your Firebase service account JSON here as one line,
# OR set the 3 individual fields below instead.
FIREBASE_SERVICE_ACCOUNT_JSON=

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Admin dashboard /admin (generate a long random secret)
ADMIN_API_KEY=
