// Prisma schema for GachaAddict backend
// Maps to the ER diagram: User, Card, Card_items, Result

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              Int      @id @default(autoincrement()) @map("user_id")
  googleId        String?  @unique @map("google_id")
  googleLinkVerified Boolean @default(false) @map("google_link_verified")
  isGoogle        Boolean  @default(false) @map("google")
  email           String   @unique
  username        String   @unique
  avatarUrl       String?  @map("avatar_url")
  password        String? // null for google-only accounts
  authVersion     Int      @default(0) @map("auth_version")
  phoneNo         String?  @map("phone_no")
  createDate      DateTime @default(now()) @map("create_date")
  updateDate      DateTime @updatedAt @map("update_date")
  lastLoginDay    String?  @map("last_login_day")
  coins           Int      @default(20)
  frameId         String?  @map("frame_id")
  frameColor      String?  @map("frame_color")
  frameUrl        String?  @map("frame_url")
  selectedThemeId String?  @map("selected_theme_id")

  syncedPulls   SyncedPull[]
  backupHistory BackupHistory[]
  frames        UserFrame[]
  cards         Card[]        @relation("UserCards")
  results       Result[]      @relation("UserResults")
  backup        UserBackup?
  favorites     Favorite[]
  themes        UserTheme[]
  missions      UserMission[]
  uploads       UploadedImage[]
  passwordResets PasswordResetChallenge[]
  selectedTheme Theme?        @relation("SelectedTheme", fields: [selectedThemeId], references: [id], onDelete: SetNull)

  @@map("user")
}

model PasswordResetChallenge {
  id               String    @id
  emailKey         String    @unique @map("email_key")
  userId           Int?      @map("user_id")
  authVersion      Int?      @map("auth_version")
  codeHash         String    @map("code_hash")
  encryptedCode    String?   @map("encrypted_code")
  attempts         Int       @default(0)
  expiresAt        DateTime  @map("expires_at")
  verifiedAt       DateTime? @map("verified_at")
  resetTokenHash   String?   @unique @map("reset_token_hash")
  deliveryAttempts Int       @default(0) @map("delivery_attempts")
  nextDeliveryAt   DateTime? @map("next_delivery_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  user             User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([nextDeliveryAt])
  @@map("password_reset_challenge")
}

model PasswordResetRateLimit {
  key       String   @id
  count     Int
  expiresAt DateTime @map("expires_at")

  @@index([expiresAt])
  @@map("password_reset_rate_limit")
}

model Card {
  id            Int      @id @default(autoincrement()) @map("card_id")
  title         String
  clientId      String?  @map("client_id")
  clientUpdatedAt DateTime? @map("client_updated_at")
  cardImage     String?  @map("card_image")
  frame         String?
  isEqualRate   Boolean  @default(false) @map("is_equal_rate")
  animation     String?
  createBy      Int      @map("create_by")
  createDate    DateTime @default(now()) @map("create_date")
  updateDate    DateTime @updatedAt @map("update_date")
  category      String   @default("Custom")
  emoji         String   @default("🎴")
  pullOneCost   Int      @default(0) @map("pull_one_cost")
  pullManyCount Int      @default(5) @map("pull_many_count")
  pullManyCost  Int      @default(0) @map("pull_many_cost")

  creator   User       @relation("UserCards", fields: [createBy], references: [id], onDelete: Cascade)
  cardItems CardItem[]
  favorites Favorite[]

  @@unique([createBy, clientId])
  @@map("card")
}

model CardItem {
  id       Int     @id @default(autoincrement()) @map("carditem_id")
  cardId   Int     @map("card_id")
  name     String
  imageUrl String? @map("image_url")
  rate     Float   @default(0) // drop rate weight (%), used when card.isEqualRate = false

  card    Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  results Result[]

  @@map("card_items")
}

model Result {
  id            Int      @id @default(autoincrement()) @map("result_id")
  cardItemId    Int?     @map("card_item_id")
  gachaId       String?  @map("gacha_id")
  gachaName     String   @default("") @map("gacha_name")
  resultElement String   @default("") @map("result_element")
  timestamp     DateTime @default(now())
  createBy      Int      @map("create_by")

  cardItem CardItem? @relation(fields: [cardItemId], references: [id], onDelete: SetNull)
  user     User      @relation("UserResults", fields: [createBy], references: [id], onDelete: Cascade)

  @@index([createBy, timestamp])
  @@map("result")
}

model Favorite {
  userId Int  @map("user_id")
  cardId Int  @map("card_id")
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  card   Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@id([userId, cardId])
  @@map("favorite")
}

model Theme {
  id           String      @id
  name         String
  price        Int
  colorPreview String      @map("color_preview")
  owners       UserTheme[]
  selectedBy   User[]      @relation("SelectedTheme")

  @@map("theme")
}

model UserTheme {
  userId      Int      @map("user_id")
  themeId     String   @map("theme_id")
  purchasedAt DateTime @default(now()) @map("purchased_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme       Theme    @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@id([userId, themeId])
  @@map("user_theme")
}

model Mission {
  id         String        @id
  title      String
  event      String
  target     Int
  coinReward Int           @map("coin_reward")
  resetEveryDays Int? @map("reset_every_days")
  resetAnchorDate String @default("2026-01-05") @map("reset_anchor_date")
  scheduleVersion Int @default(1) @map("schedule_version")
  users      UserMission[]

  @@map("mission")
}

model UserMission {
  userId    Int     @map("user_id")
  missionId String  @map("mission_id")
  progress  Int     @default(0)
  claimed   Boolean @default(false)
  periodKey String @default("1:lifetime") @map("period_key")
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  mission   Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@id([userId, missionId])
  @@map("user_mission")
}

// Local gacha/history backup. Economy balances remain in User/Theme/Mission.
model UserBackup {
  userId    Int      @id @map("user_id")
  data      Json
  revision  Int      @default(1)
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_backup")
}

model Frame {
 id String @id
 name String
 price Int
 color String
 imageUrl String? @map("image_url")
 decoration String
 owners UserFrame[]
 @@map("frame")
}
model UserFrame {
 userId Int @map("user_id")
 frameId String @map("frame_id")
 purchasedAt DateTime @default(now()) @map("purchased_at")
 user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 frame Frame @relation(fields: [frameId], references: [id], onDelete: Cascade)
 @@id([userId, frameId])
 @@map("user_frame")
}

model SyncedPull {
 userId Int @map("user_id")
 clientId String @map("client_id")
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 @@id([userId,clientId])
 @@map("synced_pull")
}

model BackupHistory {
 sequence BigInt @id @default(autoincrement())
 userId Int @map("user_id")
 clientId String @map("client_id")
 gachaId String? @map("gacha_id")
 gachaName String @map("gacha_name")
 resultElement String @map("result_element")
 pulledAt DateTime @map("pulled_at")
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 @@unique([userId,clientId])
 @@index([userId,sequence])
 @@map("backup_history")
}

model UploadedImage {
 filename String @id
 ownerId Int? @map("owner_id")
 createdAt DateTime @default(now()) @map("created_at")
 owner User? @relation(fields:[ownerId],references:[id],onDelete:Cascade)
 @@index([ownerId])
 @@map("uploaded_image")
}

// Kept only until external authentication and file cleanup has succeeded.
// No relation to User: this work must survive deleting the account.
model AccountDeletionJob {
 userId Int @id @map("user_id")
 firebaseUid String? @map("firebase_uid")
 filenames String[] @default([])
 createdAt DateTime @default(now()) @map("created_at")
 nextAttemptAt DateTime @default(now()) @map("next_attempt_at")
 attempts Int @default(0)
 lastErrorCode String? @map("last_error_code")
 @@index([nextAttemptAt])
 @@map("account_deletion_job")
}
